{
  "name": "@workspace/brand-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm --filter @workspace/aba-design-system run build",
    "predev": "pnpm run generate",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
