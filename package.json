    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@workspace/aba-design-system": "workspace:*",
    "@workspace/aba-content": "workspace:*"
  }
